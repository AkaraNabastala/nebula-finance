{
  "name": "finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "server": "node electron/server.cjs"
  },
  "build": {
    "appId": "com.nabastala.nebulafinance",
    "productName": "Nebula Finance",
    "asar": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon-apk.ico"
    },
    "icon": "src/assets/icon-apk.ico",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nebula Finance",
      "installerIcon": "src/assets/icon-apk.ico",
      "uninstallerIcon": "src/assets/icon-apk.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.470.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.2.13",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  },
  "description": "NEBULA FINANCE - Sistem Manajemen Keuangan & Pembukuan Akuntansi PT Nabastala",
  "author": "PT Nabastala"
}